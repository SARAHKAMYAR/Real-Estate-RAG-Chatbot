# Local conda helper. Docker Compose overrides DATABASE_URL inside its containers.
# Use a dedicated development database, never a production database, for ingestion/tests.
DATABASE_URL=postgresql://postgres@localhost:5433/realestate

# Select the provider explicitly. Calls use your provider account and may incur charges.
LLM_PROVIDER=groq
GROQ_API_KEY=
# To choose Claude, set LLM_PROVIDER=anthropic and fill in ANTHROPIC_API_KEY below.
ANTHROPIC_API_KEY=

# Optional external search. No key means no web access.
TAVILY_API_KEY=
# Default search is restricted to public authorities. JSON syntax is required for lists.
# WEB_ALLOWED_DOMAINS=["rijksoverheid.nl","government.nl","belastingdienst.nl"]

# Local safeguards, applied per process (not distributed account quotas).
# CHAT_REQUESTS_PER_MINUTE=30
# CHAT_MAX_CONCURRENT=2
# CHAT_MAX_BODY_BYTES=131072
# PROVIDER_TIMEOUT_SECONDS=30
# AGENT_TIMEOUT_SECONDS=90
# GROQ_RATE_LIMIT_WAITS=0
# ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# Optional data/model overrides. Defaults use the packaged fictional dataset.
# DOCUMENTS_DIR=/absolute/path/to/public/documents
# LISTINGS_FILE=/absolute/path/to/public/listings.json
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=medium
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
